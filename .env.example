# Configuración local compartida por Django y Docker Compose.
# Las variables del proceso tienen prioridad. Usar valores literales simples.
DJANGO_SECRET_KEY=solo-para-desarrollo-local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_IDENTITY_ENABLED=false

POSTGRES_DB=cooperadora
POSTGRES_USER=cooperadora
POSTGRES_PASSWORD=cooperadora_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Documentos privados de prueba (#19); no exponer como archivos estáticos.
DOCUMENTOS_MAX_UPLOAD_SIZE_BYTES=10485760
# DOCUMENT_STORAGE_ROOT=C:/ruta/privada/documentos

# Integración gastos/documentos: ruta punteada opcional (clase, fábrica o
# instancia) al proveedor real de DocumentVerificationPort. Sin valor, gastos no
# puede registrar pagos y responde 503 (fail-closed). Dejar SIN CONFIGURAR en
# este entorno hasta que el proveedor real exista y esté verificado; no poner
# aquí módulos ni proveedores ficticios (los dobles viven sólo en los tests).
# GASTOS_PAYMENT_DOCUMENT_PROVIDER=
